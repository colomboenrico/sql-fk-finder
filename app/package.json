{
  "name": "sql-fk-finder",
  "productName": "SQL FK Finder",
  "version": "1.0.0",
  "description": "Gestionale desktop per trovare i collegamenti mancanti tra tabelle SQL",
  "main": "main.js",
  "author": "Enrico Colombo",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "it.colomboenrico.sqlfkfinder",
    "productName": "SQL FK Finder",
    "artifactName": "SQL-FK-Finder-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "icona.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../sqlfk",
        "to": "sqlfk",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/*.pyc"
        ]
      },
      {
        "from": "../requirements.txt",
        "to": "requirements.txt"
      },
      {
        "from": "../esempi",
        "to": "esempi",
        "filter": [
          "esempio_*.sql",
          "dati_esempio.sql"
        ]
      }
    ],
    "icon": "icona.png",
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools",
      "identity": null,
      "extraResources": [
        {
          "from": "python/mac-${arch}",
          "to": "python"
        }
      ]
    },
    "dmg": {
      "title": "SQL FK Finder"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "extraResources": [
        {
          "from": "python/win-x64",
          "to": "python"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "SQL FK Finder"
    },
    "portable": {
      "artifactName": "SQL-FK-Finder-${version}-portatile.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "tar.gz"
      ],
      "category": "Development",
      "maintainer": "Enrico Colombo",
      "syncDesktopName": true,
      "extraResources": [
        {
          "from": "python/linux-x64",
          "to": "python"
        }
      ]
    }
  },
  "desktopName": "sql-fk-finder.desktop"
}
